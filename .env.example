# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string
# Get this from Atlas: Database > Connect > Drivers > copy the URI, then replace
# <password> and add your database name before the "?" query string.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-events?retryWrites=true&w=majority

# Long random string used to sign session cookies (any long random text is fine)
SESSION_SECRET=change-this-to-a-long-random-string

PORT=3000
