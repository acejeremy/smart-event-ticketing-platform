# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string
# Get this from Atlas: Database > Connect > Drivers > copy the URI, then replace
# <password> and add your database name before the "?" query string.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-events?retryWrites=true&w=majority

# Long random string used to sign session cookies (any long random text is fine)
SESSION_SECRET=change-this-to-a-long-random-string

# Used once by "npm run seed:admin" to create or update the first administrator.
# Replace these examples in .env only; never commit real credentials.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-8-characters

PORT=3000
