<%- include('../partials/header') %>

<h1>Upcoming Events</h1>

<!-- TODO (team): search/filter form (by date, category, availability) -->
<form class="row g-2 mb-4" method="GET" action="/">
  <div class="col-auto">
    <input type="text" name="category" class="form-control" placeholder="Category" />
  </div>
  <div class="col-auto">
    <input type="date" name="date" class="form-control" />
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-primary">Search</button>
  </div>
</form>

<!-- TODO (team): loop over `events` passed from eventController.listEvents -->
<div class="row row-cols-1 row-cols-md-3 g-4">
  <% if (events && events.length) { %>
    <% events.forEach(function(event) { %>
      <div class="col">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title"><%= event.title %></h5>
            <a href="/events/<%= event._id %>" class="btn btn-sm btn-outline-primary">View Details</a>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <p class="text-muted">No events to display yet.</p>
  <% } %>
</div>

<%- include('../partials/footer') %>
