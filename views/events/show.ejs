<%- include('../partials/header') %>

<% if (event) { %>
  <span class="badge bg-secondary mb-2"><%= event.category %></span>
  <h1><%= event.title %></h1>
  <p class="text-muted">
    <%= event.date.toDateString() %> &middot; <%= event.location %>
  </p>
  <p><%= event.description %></p>
  <p>
    <% if (event.remainingTickets > 0) { %>
      <span class="text-success"><%= event.remainingTickets %> of <%= event.capacity %> tickets remaining</span>
    <% } else { %>
      <span class="text-danger">Sold out</span>
    <% } %>
  </p>
  <!-- TODO (step 5): booking form posting to /bookings, guarded to logged-in users -->
<% } else { %>
  <p class="text-muted">Event not found.</p>
<% } %>

<%- include('../partials/footer') %>
