<%- include('../partials/header') %>

<h1>Upcoming Events</h1>

<form class="row g-2 mb-4" method="GET" action="/">
  <div class="col-auto">
    <input
      type="text"
      name="keyword"
      class="form-control"
      placeholder="Search title or description"
      value="<%= filters.keyword || '' %>"
    />
  </div>
  <div class="col-auto">
    <select name="category" class="form-select">
      <option value="">All categories</option>
      <% categories.forEach(function(cat) { %>
        <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-auto">
    <input type="date" name="date" class="form-control" value="<%= filters.date || '' %>" />
  </div>
  <div class="col-auto form-check pt-2">
    <input
      type="checkbox"
      name="available"
      value="true"
      class="form-check-input"
      id="availableOnly"
      <%= filters.available === 'true' ? 'checked' : '' %>
    />
    <label class="form-check-label" for="availableOnly">Available only</label>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-primary">Search</button>
  </div>
  <div class="col-auto">
    <a href="/" class="btn btn-outline-secondary">Clear</a>
  </div>
</form>

<div class="row row-cols-1 row-cols-md-3 g-4">
  <% if (events && events.length) { %>
    <% events.forEach(function(event) { %>
      <div class="col">
        <div class="card h-100">
          <div class="card-body">
            <span class="badge bg-secondary mb-2"><%= event.category %></span>
            <h5 class="card-title"><%= event.title %></h5>
            <p class="card-text mb-1"><%= event.date.toDateString() %></p>
            <p class="card-text mb-1"><%= event.location %></p>
            <p class="card-text">
              <% if (event.remainingTickets > 0) { %>
                <span class="text-success"><%= event.remainingTickets %> tickets left</span>
              <% } else { %>
                <span class="text-danger">Sold out</span>
              <% } %>
            </p>
            <a href="/events/<%= event._id %>" class="btn btn-sm btn-outline-primary">View Details</a>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <p class="text-muted">No events match your search.</p>
  <% } %>
</div>

<%- include('../partials/footer') %>
