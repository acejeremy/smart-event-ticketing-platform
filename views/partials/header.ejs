<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Advanced Events</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
      <a class="navbar-brand" href="/">Advanced Events</a>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#mainNav"
        aria-controls="mainNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <div class="navbar-nav ms-auto">
          <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Events</a>
          <a class="nav-link <%= currentPath === '/contact' ? 'active' : '' %>" href="/contact">Contact</a>
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <a class="nav-link <%= currentPath === '/bookings/dashboard' ? 'active' : '' %>" href="/bookings/dashboard">Dashboard</a>
            <% if (currentUser.role === 'admin') { %>
              <a class="nav-link <%= currentPath.startsWith('/admin/events') ? 'active' : '' %>" href="/admin/events">Manage Events</a>
              <a class="nav-link <%= currentPath === '/contact/admin' ? 'active' : '' %>" href="/contact/admin">Enquiries</a>
            <% } %>
            <form action="/auth/logout" method="POST" class="d-inline">
              <button type="submit" class="btn btn-link nav-link">Logout</button>
            </form>
          <% } else { %>
            <a class="nav-link <%= currentPath === '/auth/login' ? 'active' : '' %>" href="/auth/login">Login</a>
            <a class="nav-link <%= currentPath === '/auth/register' ? 'active' : '' %>" href="/auth/register">Register</a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>
  <main class="container py-4">
